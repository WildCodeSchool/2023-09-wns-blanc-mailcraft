{
  "compilerOptions": {
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false, // Assouplit les vérifications strictes
    "noImplicitAny": false, // Permet le type 'any' implicite
    "noImplicitThis": false, // Permet le type implicite 'any' pour 'this'
    "strictNullChecks": false, // Permet des valeurs null/undefined implicites
    "strictFunctionTypes": false, // Assouplit les vérifications des types des fonctions
    "strictPropertyInitialization": false, // Permet des propriétés non initialisées
    "noEmitOnError": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "noEmit": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
